{
  "manifest_version": 1,
  "id": "artifacts",
  "name": "ARTIFACTS",
  "summary": "Documents and canvases you and an agent can assemble and mark up together. Every drawing stays attached to a named element.",
  "category": "studio",
  "maker": {
    "name": "OpenRig",
    "url": "https://github.com/openrig"
  },
  "surface": {
    "entry": "app/artifacts.html",
    "path": "/surfaces/artifacts.html",
    "glyph": "✎",
    "hint": "paste images into a document or canvas, arrange them, and share structured annotations with an agent"
  },
  "roots": {
    "artifacts": {
      "required": true
    }
  },
  "calls": {
    "/api/annotations": { "required": true },
    "/api/artifacts": { "required": true },
    "/api/artifacts/item": { "required": true },
    "/api/artifacts/annotations": { "required": true },
    "/api/artifacts/annotations/migrate": { "required": true },
    "/api/artifacts/assets": { "required": true },
    "/api/artifacts/items": { "required": true },
    "/api/artifacts/screenshot": { "required": true }
  },
  "provider": {
    "package": "@openrig/studio-artifacts",
    "required": true
  }
}
